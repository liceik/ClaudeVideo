{
  "audio": "vo3.wav",
  "duration": 93.91,
  "chunks": [
    {
      "i": 0,
      "scene": "choice",
      "text": "Вы выбрали: **бежать**.",
      "start": 0.1,
      "end": 2.14
    },
    {
      "i": 1,
      "scene": "roll",
      "text": "Глаза *закрыты*. Ты скатываешься с кровати.",
      "start": 2.34,
      "end": 5.85
    },
    {
      "i": 2,
      "scene": "cheekoff",
      "text": "Пальцы *соскальзывают* со щеки.",
      "start": 6.05,
      "end": 8.33
    },
    {
      "i": 3,
      "scene": "sigh",
      "text": "За спиной — **вздох**. Долгий.",
      "start": 8.53,
      "end": 11.63
    },
    {
      "i": 4,
      "scene": "crawl",
      "text": "Пол холодный. Ты ползёшь на *голос*.",
      "start": 11.83,
      "end": 14.87
    },
    {
      "i": 5,
      "scene": "voiceCorr",
      "text": "«Сюда, *солнышко*. Скорее».",
      "start": 15.07,
      "end": 17.17
    },
    {
      "i": 6,
      "scene": "stand",
      "text": "Что-то **встаёт**. Пружины распрямляются.",
      "start": 17.37,
      "end": 20.42
    },
    {
      "i": 7,
      "scene": "steps",
      "text": "**Шаги**. Медленные. За тобой.",
      "start": 20.62,
      "end": 23.75
    },
    {
      "i": 8,
      "scene": "reach",
      "text": "Ты нащупываешь *дверь*.",
      "start": 23.95,
      "end": 25.48
    },
    {
      "i": 9,
      "scene": "knob",
      "text": "Ручка. **Холодная**.",
      "start": 25.68,
      "end": 27.44
    },
    {
      "i": 10,
      "scene": "stuck",
      "text": "Дверь **не поддаётся**.",
      "start": 27.64,
      "end": 29.17
    },
    {
      "i": 11,
      "scene": "push",
      "text": "Голос из коридора: «*Толкай!*»",
      "start": 29.37,
      "end": 31.51
    },
    {
      "i": 12,
      "scene": "behind",
      "text": "Голос сзади: «**Не слушай её**».",
      "start": 31.71,
      "end": 34.01
    },
    {
      "i": 13,
      "scene": "both",
      "text": "Оба — *мамины*.",
      "start": 34.21,
      "end": 35.71
    },
    {
      "i": 14,
      "scene": "open",
      "text": "Ты толкаешь. Дверь *открывается*.",
      "start": 35.91,
      "end": 39.29
    },
    {
      "i": 15,
      "scene": "light",
      "text": "*Свет*. Даже сквозь веки — жёлтый.",
      "start": 39.49,
      "end": 41.73
    },
    {
      "i": 16,
      "scene": "grab",
      "text": "*Тёплые* руки хватают тебя. Втаскивают.",
      "start": 41.93,
      "end": 46.95
    },
    {
      "i": 17,
      "scene": "slam",
      "text": "**Хлоп**. Дверь за спиной.",
      "start": 47.15,
      "end": 49.34
    },
    {
      "i": 18,
      "scene": "hug",
      "text": "«Всё. Всё. Я *здесь*».",
      "start": 49.54,
      "end": 50.34
    },
    {
      "i": 19,
      "scene": "mum",
      "text": "Это мама. Пахнет *блинами*.",
      "start": 50.54,
      "end": 51.69
    },
    {
      "i": 20,
      "scene": "hugClose",
      "text": "Ты прижимаешься. Глаз **не открываешь**.",
      "start": 51.89,
      "end": 54.68
    },
    {
      "i": 21,
      "scene": "silence",
      "text": "За дверью — *тишина*.",
      "start": 54.88,
      "end": 56.63
    },
    {
      "i": 22,
      "scene": "knock",
      "text": "Потом тихий стук. **Раз**.",
      "start": 56.83,
      "end": 58.52
    },
    {
      "i": 23,
      "scene": "knock",
      "text": "**Два**.",
      "start": 58.72,
      "end": 59.42
    },
    {
      "i": 24,
      "scene": "knock",
      "text": "**Три**.",
      "start": 59.62,
      "end": 60.4
    },
    {
      "i": 25,
      "scene": "voiceRoom",
      "text": "И *твой собственный* голос из комнаты:",
      "start": 60.6,
      "end": 63.56
    },
    {
      "i": 26,
      "scene": "voiceRoom",
      "text": "«Мам, открой. Мне **страшно**».",
      "start": 63.76,
      "end": 66.36
    },
    {
      "i": 27,
      "scene": "squeeze",
      "text": "Мама сжимает тебя *крепче*.",
      "start": 66.56,
      "end": 68.39
    },
    {
      "i": 28,
      "scene": "whisper",
      "text": "«**Не отвечай**», — шепчет она.",
      "start": 68.59,
      "end": 70.57
    },
    {
      "i": 29,
      "scene": "nightlight",
      "text": "*Ночник* остался в комнате.",
      "start": 70.77,
      "end": 72.55
    },
    {
      "i": 30,
      "scene": "strip",
      "text": "Под дверью — *полоска света*.",
      "start": 72.75,
      "end": 74.7
    },
    {
      "i": 31,
      "scene": "stripBlink",
      "text": "Она **мигает**. Раз. Два.",
      "start": 74.9,
      "end": 77.52
    },
    {
      "i": 32,
      "scene": "mumWhisper",
      "text": "Мама шепчет: «*Открой глаза*. Посмотри на меня».",
      "start": 77.72,
      "end": 81.47
    },
    {
      "i": 33,
      "scene": "end",
      "text": "*Открыть* глаза и увидеть, кто тебя держит?",
      "start": 81.67,
      "end": 84.77
    },
    {
      "i": 34,
      "scene": "end",
      "text": "Или *ответить* голосу из комнаты?",
      "start": 84.97,
      "end": 87.18
    },
    {
      "i": 35,
      "scene": "end",
      "text": "Напиши в комментариях: *открыть* или **ответить**.",
      "start": 87.38,
      "end": 90.99
    },
    {
      "i": 36,
      "scene": "end",
      "text": "Часть четыре — по *вашему* выбору.",
      "start": 91.19,
      "end": 93.71
    }
  ],
