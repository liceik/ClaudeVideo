      "end": 72.87
    },
    {
      "i": 26,
      "scene": "take",
      "text": "Ты берёшь его. Он тёплый.",
      "start": 73.57,
      "end": 75.45
    },
    {
      "i": 27,
      "scene": "morning",
      "text": "Утром мама будит тебя в кровати.",
