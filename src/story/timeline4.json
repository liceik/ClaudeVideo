    {
      "i": 12,
      "scene": "steps",
      "text": "Шаги. Маленькие. Детские.",
      "start": 33.94,
      "end": 36.03
    },
    {
      "i": 13,
      "scene": "voice",
      "text": "И твой голос говорит: «Открой глаза. Правило второе».",
      "start": 36.63,
      "end": 40.4
    },
    {
      "i": 14,
      "scene": "rule2",
      "text": "«Если ответил — смотри. Иначе останешься там, где ты сейчас».",
      "start": 41.0,
      "end": 45.19
    },
    {
      "i": 15,
      "scene": "behind",
      "text": "Сзади — та, что держала тебя. Шипит: «Не смотри».",
      "start": 45.89,
      "end": 49.03
    },
    {
      "i": 16,
      "scene": "front",
      "text": "Спереди — твой голос: «Смотри».",
      "start": 49.53,
      "end": 51.41
    },
    {
      "i": 17,
      "scene": "hum",
      "text": "Ночник у кого-то в руках. Ты слышишь, как он гудит.",
      "start": 52.11,
      "end": 55.46
    },
    {
      "i": 18,
      "scene": "blink",
      "text": "Раз.",
      "start": 56.06,
      "end": 56.47
    },
    {
      "i": 19,
      "scene": "blink",
      "text": "Два.",
      "start": 57.07,
      "end": 57.48
    },
    {
      "i": 20,
      "scene": "blink",
      "text": "Три.",
      "start": 58.08,
      "end": 58.49
    },
    {
      "i": 21,
      "scene": "open",
      "text": "Ты открываешь глаза.",
      "start": 59.19,
      "end": 60.86
    },
    {
      "i": 22,
      "scene": "double",
      "text": "Перед тобой — ты. В пижаме. С ночником.",
      "start": 61.66,
      "end": 64.17
