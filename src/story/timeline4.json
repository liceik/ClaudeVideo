  "chunks": [
    {
      "i": 0,
      "scene": "choice",
      "text": "Вы выбрали: **ответить**.",
      "start": 1.2,
      "end": 2.26
    },
    {
      "i": 1,
      "scene": "answer",
      "text": "Ты открываешь рот: «*Мам*… это ты?»",
      "start": 2.46,
      "end": 6.15
    },
    {
      "i": 2,
      "scene": "silence",
      "text": "*Тишина*.",
      "start": 6.35,
      "end": 7.27
    },
    {
      "i": 3,
      "scene": "freeze",
      "text": "Руки, что держат тебя, **замирают**.",
      "start": 7.47,
      "end": 10.22
    },
    {
      "i": 4,
      "scene": "squeeze",
      "text": "Потом сжимаются. Сильнее. **Слишком сильно**.",
      "start": 10.42,
      "end": 14.44
    },
    {
      "i": 5,
      "scene": "notMum",
      "text": "Голос у уха уже **не мамин**: «Ты ответил».",
      "start": 14.64,
      "end": 18.36
    },
    {
      "i": 6,
      "scene": "rule1",
      "text": "Первое правило. **Не отвечай**.",
      "start": 18.56,
      "end": 21.01
    },
    {
      "i": 7,
      "scene": "found",
      "text": "Ты ответил. **Тебя нашло**.",
      "start": 21.21,
      "end": 23.36
    },
    {
      "i": 8,
      "scene": "fall",
      "text": "Ты *вырываешься*. Падаешь на пол.",
      "start": 23.56,
      "end": 25.68
    },
    {
      "i": 9,
      "scene": "lock",
      "text": "**Щёлк**. Замок.",
      "start": 25.88,
      "end": 27.39
    },
    {
      "i": 10,
      "scene": "doorOpens",
      "text": "Дверь в комнату открывается *сама*.",
      "start": 27.59,
      "end": 29.86
    },
    {
      "i": 11,
      "scene": "lightDoor",
      "text": "Полоска света становится *дверью света*.",
      "start": 30.06,
      "end": 32.92
    },
    {
      "i": 12,
      "scene": "steps",
      "text": "**Шаги**. Маленькие. Детские.",
      "start": 33.12,
      "end": 35.77
    },
    {
      "i": 13,
      "scene": "voice",
      "text": "И *твой голос* говорит: «Открой глаза. Правило второе».",
      "start": 35.97,
      "end": 40.05
    },
    {
      "i": 14,
      "scene": "rule2",
      "text": "«Если ответил — **смотри**. Иначе останешься там, где ты сейчас».",
      "start": 40.25,
      "end": 45.22
    },
    {
      "i": 15,
      "scene": "behind",
      "text": "Сзади — та, что держала тебя. Шипит: «**Не смотри**».",
      "start": 45.42,
      "end": 49.68
    },
    {
      "i": 16,
      "scene": "front",
      "text": "Спереди — твой голос: «*Смотри*».",
      "start": 49.88,
      "end": 52.7
    },
    {
      "i": 17,
      "scene": "hum",
      "text": "*Ночник* у кого-то в руках. Ты слышишь, как он гудит.",
      "start": 52.9,
      "end": 56.23
    },
    {
      "i": 18,
      "scene": "blink",
      "text": "Раз.",
      "start": 56.43,
      "end": 57.05
    },
    {
      "i": 19,
      "scene": "blink",
      "text": "Два.",
      "start": 57.25,
      "end": 57.94
    },
    {
      "i": 20,
      "scene": "blink",
      "text": "**Три**.",
      "start": 58.14,
      "end": 58.66
    },
    {
      "i": 21,
      "scene": "open",
      "text": "Ты *открываешь глаза*.",
      "start": 58.86,
      "end": 60.17
    },
    {
      "i": 22,
      "scene": "double",
      "text": "Перед тобой — **ты**. В пижаме. С ночником.",
      "start": 60.37,
      "end": 63.83
    },
    {
      "i": 23,
      "scene": "emptyCorridor",
      "text": "За спиной — пустой коридор. *Никого*.",
      "start": 64.03,
      "end": 66.92
    },
    {
      "i": 24,
      "scene": "offer",
      "text": "Двойник протягивает ночник: «Теперь он **твой**».",
      "start": 67.12,
      "end": 70.46
    },
    {
      "i": 25,
      "scene": "ruleToo",
      "text": "«И *правило* тоже».",
      "start": 70.66,
      "end": 71.85
    },
    {
      "i": 26,
      "scene": "take",
      "text": "Ты берёшь его. Он *тёплый*.",
      "start": 72.05,
      "end": 74.23
    },
    {
      "i": 27,
      "scene": "morning",
      "text": "Утром мама будит тебя в кровати.",
      "start": 74.43,
      "end": 77.91
    },
    {
      "i": 28,
      "scene": "realMum",
      "text": "*Настоящая*. Моргает.",
      "start": 78.11,
      "end": 80.04
    },
    {
      "i": 29,
      "scene": "mumSays",
      "text": "Мама говорит: «Ты всю ночь *звал меня* по имени».",
      "start": 80.24,
      "end": 82.45
    },
    {
      "i": 30,
      "scene": "mumRule",
      "text": "«А я **не отвечала**. Такое правило».",
      "start": 82.65,
      "end": 85.14
    },
    {
      "i": 31,
      "scene": "blink1",
      "text": "Ночник **мигает**. Раз.",
      "start": 85.34,
      "end": 87.43
    },
    {
      "i": 32,
      "scene": "end",
      "text": "*Выбросить* ночник?",
      "start": 87.63,
      "end": 88.9
    },
    {
      "i": 33,
      "scene": "end",
      "text": "Или оставить — и *передать* правило дальше?",
      "start": 89.1,
      "end": 91.69
    },
    {
      "i": 34,
      "scene": "end",
      "text": "Напиши в комментариях: *выбросить* или **передать**.",
