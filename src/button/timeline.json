{
  "audio": "vo_btn1.mp3",
  "duration": 64.0,
  "chunks": [
    {
      "i": 0,
      "scene": "panel",
      "text": "В моём доме девять этажей.",
      "start": 0.1,
      "end": 2.13
    },
    {
      "i": 1,
      "scene": "panel",
      "text": "Я живу здесь шесть лет и знаю это точно.",
      "start": 2.33,
      "end": 5.35
    },
    {
      "i": 2,
      "scene": "lift",
      "text": "Вчера вечером я зашёл в лифт и увидел...",
      "start": 5.55,
      "end": 8.24
    },
    {
      "i": 3,
      "scene": "button",
      "text": "десятую кнопку.",
      "start": 8.44,
      "end": 9.92
    },
    {
      "i": 4,
      "scene": "button",
      "text": "Она не горела. Просто была.",
      "start": 10.12,
      "end": 12.36
    },
    {
      "i": 5,
      "scene": "button",
      "text": "Чёрная, без цифры, с одной царапиной,",
      "start": 12.56,
      "end": 14.23
    },
    {
      "i": 6,
      "scene": "button",
      "text": "как будто её нарисовали ногтем.",
      "start": 14.43,
      "end": 17.37
    },
    {
      "i": 7,
      "scene": "phone",
      "text": "Я сфотографировал панель, хотел показать соседям.",
      "start": 17.57,
      "end": 20.54
    },
    {
      "i": 8,
      "scene": "phone",
      "text": "На фото кнопки не было.",
      "start": 20.73,
      "end": 22.38
    },
    {
      "i": 9,
      "scene": "desk",
      "text": "Утром я спросил консьержку.",
      "start": 22.58,
      "end": 24.32
    },
    {
      "i": 10,
      "scene": "desk",
      "text": "Она посмотрела на меня странно.",
      "start": 24.52,
      "end": 26.33
    },
    {
      "i": 11,
      "scene": "desk",
      "text": "«Какой десятый?",
      "start": 26.53,
      "end": 27.58
    },
    {
      "i": 12,
      "scene": "desk",
      "text": "Крышу заперли ещё в две тысячи третьем».",
      "start": 27.78,
      "end": 30.17
    },
    {
      "i": 13,
      "scene": "night",
      "text": "Сегодня ночью я вернулся поздно.",
      "start": 30.37,
      "end": 32.42
    },
    {
      "i": 14,
      "scene": "night",
      "text": "Лифт приехал сам.",
      "start": 32.62,
      "end": 34.0
    },
    {
      "i": 15,
      "scene": "cabin",
      "text": "Двери открылись до того, как я нажал кнопку.",
      "start": 34.2,
      "end": 36.91
    },
    {
      "i": 16,
      "scene": "cabin",
      "text": "Внутри горела одна подсветка.",
      "start": 37.11,
      "end": 39.03
    },
    {
      "i": 17,
      "scene": "cabin",
      "text": "Десятая.",
      "start": 39.23,
      "end": 40.24
    },
    {
      "i": 18,
      "scene": "voice",
      "text": "А потом лифт заговорил.",
      "start": 40.44,
      "end": 42.34
    },
    {
      "i": 19,
      "scene": "voice",
      "text": "Тихо, женским голосом, как в объявлениях.",
      "start": 42.54,
      "end": 45.41
    },
    {
      "i": 20,
      "scene": "voice",
      "text": "«Десятый этаж. Вас ждут».",
      "start": 45.61,
      "end": 48.11
    },
    {
      "i": 21,
      "scene": "display",
      "text": "Двери закрылись сами. На табло: девять...",
      "start": 48.31,
      "end": 51.65
    },
    {
      "i": 22,
      "scene": "display",
      "text": "десять...",
      "start": 51.85,
      "end": 52.59
    },
    {
      "i": 23,
      "scene": "display",
      "text": "одиннадцать.",
      "start": 52.79,
      "end": 54.01
    },
    {
      "i": 24,
      "scene": "doors",
      "text": "Что мне делать?",
      "start": 54.21,
      "end": 55.29
    },
    {
      "i": 25,
      "scene": "end",
      "text": "Вариант А: нажать «Стоп» и остаться в кабине.",
      "start": 55.49,
      "end": 58.56
    },
    {
      "i": 26,
      "scene": "end",
      "text": "Вариант Б: выйти, когда двери откроются.",
      "start": 58.76,
      "end": 61.58
    },
    {
      "i": 27,
      "scene": "end",
      "text": "Пишите в комментариях: А или Б.",
      "start": 61.78,
      "end": 63.8
    }
  ],
